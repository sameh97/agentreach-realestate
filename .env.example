# ─────────────────────────────────────────────────────────────
# AgentReach — environment variables
# Copy this file to .env and fill in what you have. Every key
# has a safe fallback (demo data / rule-based parsing), so the
# app runs out of the box with nothing filled in — you just
# won't get real-world results until you add real keys.
# ─────────────────────────────────────────────────────────────

# ── LLM (query parsing) ─────────────────────────────────────
# Format: "provider:model". Falls back to a rule-based parser
# (regex, no LLM) if this fails or is left unset.
#
# Default: Groq's free tier running an open-weight model — no
# GPU server needed. Free key: https://console.groq.com/keys
LLM_MODEL=groq:openai/gpt-oss-20b
GROQ_API_KEY=
#
# Or OpenAI (paid):
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=

# Or fully self-hosted via Ollama (needs ~4GB RAM for qwen2.5:3b).
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Maps scraping (real estate agents & brokerages) ─────────
# RapidAPI "Local Business Data" by OpenWeb Ninja.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/local-business-data
# Without this key, AgentReach serves realistic demo data instead
# of live results — useful for testing the UI without spending quota.
RAPIDAPI_KEY=

# Optional fallback: SearchApi.io Google Maps engine, used when
# the RapidAPI lookup fails. https://www.searchapi.io
SEARCHAPI_KEY=

# ── Email verification ──────────────────────────────────────
# RapidAPI "Verify Email Pro" — checks syntax, MX records, and
# SMTP deliverability before a lead is marked "verified".
# (Uses the same RAPIDAPI_KEY above.)

# ── Database (MongoDB) ──────────────────────────────────────
# Local (default): the "local-db" profile starts a mongo
# container and the backend connects to it automatically.
COMPOSE_PROFILES=local-db
#
# MongoDB Atlas: comment out COMPOSE_PROFILES above and set your
# Atlas connection string here. That's the whole switch.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=agentreach

# ── Auth ────────────────────────────────────────────────────
# Signs login tokens. REQUIRED — use a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every user out.
JWT_SECRET=
JWT_TTL_DAYS=7

# ── Public demo guardrails ──────────────────────────────────
# Every search spends Groq + RapidAPI quota. For a public demo
# keep these low. 0 = no daily limit.
# MAX_RESULTS_CAP=20
# DAILY_SEARCH_LIMIT=5
#
# Browser origins allowed to call the API (comma-separated).
# Set to your frontend URL in production.
# CORS_ORIGINS=https://your-app.vercel.app

# ── Frontend → Backend wiring ───────────────────────────────
# Public URL the BROWSER uses to reach the backend. Set this to
# your real domain when you deploy (e.g. https://api.yourdomain.com).
NEXT_PUBLIC_API_URL=http://localhost:8000
